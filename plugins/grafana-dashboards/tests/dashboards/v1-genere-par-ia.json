            "type": "prometheus",
            "uid": "P1809F7CD0C75ACF3"
          },
          "expr": "sum by (pod) (container_memory_working_set_bytes)",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
